# Local desktop defaults. Do not expose the service beyond loopback.
RUASKITA_STORAGE_BACKEND=sqlite
RUASKITA_DB=services/api/data/workspace.sqlite3
RUASKITA_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RUASKITA_DISABLE_MODEL=0

# Reserved for the future PostgreSQL/PostGIS adapter. Setting the backend to
# postgres before that adapter lands intentionally makes /ready return 503.
# RUASKITA_DATABASE_URL=postgresql://ruaskita:change-me@127.0.0.1:5432/ruaskita
