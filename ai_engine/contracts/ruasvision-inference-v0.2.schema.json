{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruaskita.local/contracts/ruasvision-inference-v0.2.schema.json",
  "title": "RuasVision inference response",
  "type": "object",
  "required": ["generated_at", "engine", "model", "image", "image_shape", "confidence_threshold", "potholes", "depth_policy"],
  "properties": {
    "generated_at": { "type": "string", "format": "date-time" },
    "engine": { "type": "string", "pattern": "^RuasVision v0\\.[0-9]+$" },
    "model": { "type": "string" },
    "image": { "type": "string" },
    "image_shape": {
      "type": "object",
      "required": ["height", "width"],
      "properties": {
        "height": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1 }
      }
    },
    "confidence_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "potholes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "confidence", "bbox_xyxy", "polygon_xy"],
        "properties": {
          "class": { "const": "pothole" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "bbox_xyxy": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "number" }
          },
          "polygon_xy": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "number" }
            }
          }
        }
      }
    },
    "depth_policy": {
      "type": "string",
      "description": "No metric depth is returned until field calibration is complete."
    }
  }
}
